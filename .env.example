# ---- Third-party keys ------------------------------------------------------
# Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Tavily web search (https://app.tavily.com)
# Optional: without it the agent still runs, it just tells you research is off.
TAVILY_API_KEY=

# ---- Optional model overrides ----------------------------------------------
# Leave these commented out to use the app's built-in defaults (see
# agent_factory.DEFAULT_FAST_MODEL / DEFAULT_DEEP_MODEL). Any Gemini model id
# your key can access works — set the ones you actually have access to.
# GEMINI_FAST_MODEL=gemini-3.6-flash
# GEMINI_DEEP_MODEL=gemini-3.6-pro